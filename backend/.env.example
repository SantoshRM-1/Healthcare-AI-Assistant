APP_NAME=MedAssist AI API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/medassist
CLERK_ISSUER=https://your-clerk-domain.clerk.accounts.dev
CLERK_JWKS_URL=https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
REPORT_MAX_SIZE_MB=20
REPORT_MAX_PDF_PAGES=100
GEMINI_API_KEY=
GEMINI_TIMEOUT_SECONDS=60
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
CHROMA_PERSIST_DIRECTORY=./.chroma
# For multi-instance deployments use a protected Chroma server:
# CHROMA_HTTP_HOST=chroma
# CHROMA_HTTP_PORT=8000
# CHROMA_SSL=false
# CHROMA_API_TOKEN=
RAG_TOP_K=8
RAG_MAX_COSINE_DISTANCE=0.65
RAG_CHUNK_SIZE_CHARS=1600
RAG_CHUNK_OVERLAP_CHARS=200
REPORT_PROCESSING_MAX_ATTEMPTS=5
WHISPER_MODEL_SIZE=small
WHISPER_BEAM_SIZE=3
VOICE_MAX_SIZE_MB=20
VOICE_MAX_DURATION_SECONDS=180
# For complete Kannada glyph support in PDF exports, set this to a TTF font with Kannada glyphs.
# EXPORT_FONT_PATH=/usr/share/fonts/truetype/noto/NotoSansKannada-Regular.ttf
HOSPITAL_MAX_RESULTS=10
RESEND_API_KEY=
EMAIL_FROM=
# EMAIL_REPLY_TO=
